{:id       :isaac.foreman
 :version  "0.6.0"
 :builtin? true
 :handbook "isaac/foreman/handbook.md"
 :factory  isaac.foreman.module/create-module

 :isaac.agent/tools
 {:foreman/signal {:factory isaac.foreman.tool/foreman-signal-tool-factory}
  :foreman/data {:factory isaac.foreman.tool/foreman-data-tool-factory}}

 :isaac.http/route
 [{:method :post :path "/foreman/events" :handler isaac.foreman.http/handler}
  {:method :post :path "/foreman/instances/:machine/:id/data" :handler isaac.foreman.http/data-handler}]

 :isaac/cli
 {:foreman
  {:usage     "foreman <subcommand> [options]"
   :summary   "Drive and inspect machine instances"
   :namespace isaac.foreman.cli}}

 :berths {:isaac.foreman/action
          {:description "Foreman action implementations keyed by action type"
           :schema {:type :map :key-spec {:type :keyword}
                    :value-spec {:type :map
                                 :factory isaac.foreman.action/register!
                                 :schema {:handler {:type :symbol :validations [:present?]}
                                          :action-spec {:type :schema-map}}}}}}

 :isaac.foreman/action
 {:log {:handler isaac.foreman.action/log!}
  :turn {:handler isaac.foreman.action/turn!}
  :notify {:handler isaac.foreman.action/notify!}
  :exec {:handler isaac.foreman.action/exec!}}

 :isaac.config/schema
 {:foreman
  {:schema
   {:name        :foreman
    :type        :map
    :description "Shared action pool for machines (machine-local :actions wins)"
    :schema      {:actions
                  {:type        :map
                   :description "Named actions shared across machines"
                   :key-spec    {:type :keyword}
                   :value-spec  {:type   :map
                                 :dynamic-schema {:berth :isaac.foreman/action :path [:action-spec]}
                                 :schema {:type    {:type        :keyword
                                                    :description "Built-in action type (:log, :turn, :notify)"
                                                    :validations [[:registered-in? :isaac.foreman/action]]}
                                          :message {:type        :string
                                                    :description "Printed by :log actions"}
                                          :frequencies {:type :map :key-spec {:type :keyword} :value-spec {:type :any} :description "Agent session frequencies"}
                                          :resource-pools {:type :seq :spec {:type :string}
                                                           :description "Resource pool ids a :turn action's turn must lease before it runs; ignored by :log/:notify actions"}
                                          :command {:type :seq :spec {:type :string} :description "Argv for :exec (no implicit shell)"}
                                          :output {:type :map :schema {:data {:type :keyword :description "Instance data key for action output"}}}
                                          :cwd {:type :string :description "Templated working directory for :exec"}
                                          :timeout {:type :int :description "Seconds before :exec is killed (default 60)"}
                                          :prompt {:type :string
                                                   :description "Prompt template for a :turn action, filled with {{machine}}, {{instance}}, and {{data.<key>}} from the merged instance data"}}}}}}}

  :machines
  {:entity-dir         "machines"
   :merge-root-entity? true
   :schema
   {:name        "machine table"
    :type        :map
    :description "State-machine tables (map of id -> machine)"
    :key-spec    {:type :string}
    :value-spec
    {:name        :machine
     :type        :map
     :description "One state machine"
     :schema      {:initial     {:type        :keyword
                                 :description "Birth state for new instances"
                                 :validations [:present?]}
                   :observers   {:type        :seq
                                 :description "Observer ids notified of handled transitions"
                                 :spec        {:type :keyword}}
                   :actions     {:type        :map
                                 :description "Named actions local to this machine"
                                 :key-spec    {:type :keyword}
                                 :value-spec  {:type   :map
                                               :dynamic-schema {:berth :isaac.foreman/action :path [:action-spec]}
                                               :schema {:type    {:type        :keyword
                                                                  :description "Built-in action type"
                                                                  :validations [[:registered-in? :isaac.foreman/action]]}
                                                        :message {:type        :string
                                                                  :description "Printed by :log actions"}
                                                        :frequencies {:type :map :key-spec {:type :keyword} :value-spec {:type :any} :description "Agent session frequencies"}
                                                        :resource-pools {:type :seq :spec {:type :string}
                                                                         :description "Resource pool ids a :turn action's turn must lease before it runs; ignored by :log/:notify actions"}
                                                        :command {:type :seq :spec {:type :string} :description "Argv for :exec (no implicit shell)"}
                                          :output {:type :map :schema {:data {:type :keyword :description "Instance data key for action output"}}}
                                          :cwd {:type :string :description "Templated working directory for :exec"}
                                          :timeout {:type :int :description "Seconds before :exec is killed (default 60)"}
                                          :prompt {:type :string
                                                                 :description "Prompt template for a :turn action, filled with {{machine}}, {{instance}}, and {{data.<key>}} from the merged instance data"}}}}
                   :states      {:type        :map
                                 :description "Optional per-state :entry / :exit action lists"
                                 :key-spec    {:type :keyword}
                                 :value-spec  {:type   :map
                                               :schema {:entry {:type :seq :spec {:type :keyword}}
                                                        :exit  {:type :seq :spec {:type :keyword}}}}}
                   :transitions {:type        :seq
                                 :description "Rows {:start :event :end :actions}; :* matches any start"
                                 :spec        {:type   :map
                                               :schema {:start   {:type :keyword :validations [:present?]
                                                                  :description "Starting state this row matches, or :* to match any state (an explicit row wins over a wildcard row for the same event)"}
                                                        :event   {:type :keyword :validations [:present?]
                                                                  :description "Event keyword this row matches"}
                                                        :end     {:type :keyword :validations [:present?]
                                                                  :description "State the instance moves to when this row fires"}
                                                        :actions {:type        :seq
                                                                  :spec        {:type :keyword}
                                                                  :description "Vector of action names fired by this transition, in order"}}}}}}}}}

 :isaac.config/check
 {:dangling-actions {:fn isaac.foreman.checks/check-dangling-actions}
  :actions-shape    {:fn isaac.foreman.checks/check-actions-shape}}}
